@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="card">
    <h1 class="section-heading">Something went wrong</h1>
    <p>The request could not be completed. Operations either complete fully or not at all, so return to the dashboard to see the current balances and history.</p>
    <p><a class="button" asp-page="/Index">Back to dashboard</a></p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Request ID: <code>@Model.RequestId</code></p>
    }
</section>
